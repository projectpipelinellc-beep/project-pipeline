# Copy this file to .env.local for local development, and add the same
# values in Vercel under Project Settings -> Environment Variables for
# production. See README.md for full setup instructions.

# Required for the contact form to email new leads (see "Contact Form
# Email Notifications" in README.md). Get a free API key at resend.com.
RESEND_API_KEY=

# Optional. Once a sending domain is verified in Resend, set this to send
# from your own domain, e.g. "Project Pipeline <leads@projectpipeline.co>".
# Until then, leads are sent from Resend's shared onboarding address.
EMAIL_FROM=
